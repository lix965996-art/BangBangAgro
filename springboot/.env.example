# ========================================
# 帮帮农智慧农业平台 - 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ========================================

# ---- 数据库配置（必填）----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart-agriculture
DB_USERNAME=root
DB_PASSWORD=your_password_here

# ---- JWT 密钥（必填，长度 >= 32 字符）----
JWT_SECRET=your_jwt_secret_at_least_32_chars_here

# ---- 高德地图 API（天气/地图功能需要）----
AMAP_WEB_KEY=your_amap_web_key
AMAP_JS_KEY=your_amap_js_key
AMAP_JS_SECURITY_KEY=your_amap_js_security_key
AMAP_CITY=430800

# ---- 通义千问 AI（智能 Agent 功能需要）----
QWEN_API_KEY=your_qwen_api_key

# ---- DeepSeek AI（可选，替代千问）----
DEEPSEEK_API_KEY=your_deepseek_api_key

# ---- OneNET 物联网平台（硬件控制需要）----
ONENET_AUTHOR_KEY=your_onenet_author_key
ONENET_PRODUCT_ID=your_product_id
ONENET_DEVICE_NAME=your_device_name
ONENET_NEW_PRODUCT_ID=your_new_product_id
ONENET_NEW_DEVICE_NAME=your_new_device_name

# ---- Python 检测服务（果蔬检测功能需要）----
PYTHON_API_URL=http://localhost:5000

# ---- IoT 回调密钥（可选）----
IOT_CALLBACK_SECRET=your_callback_secret

# ---- 文件上传路径（可选）----
UPLOAD_PATH=${user.home}/smart-agriculture-uploads/
