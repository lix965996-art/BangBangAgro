# 帮帮农项目代码风格统一配置
# https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Java / Kotlin
[*.{java,kt,kts}]
indent_size = 4
max_line_length = 120

# 前端
[*.{js,jsx,ts,tsx,vue,json,yml,yaml}]
indent_size = 2

# Markdown 保留尾部空格(用于换行)
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# SQL
[*.sql]
indent_size = 2

# Maven / Gradle
[*.xml]
indent_size = 4

# Shell
[*.{sh,bash}]
indent_size = 2

# Python
[*.py]
indent_size = 4
max_line_length = 100

# Windows 批处理
[*.{bat,cmd}]
end_of_line = crlf
